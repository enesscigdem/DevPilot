{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "SingleLine": true
      }
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "MergePolicy": {
    "AllowNoChecks": true
  },
  "AiProvider": {
    "Kimi": {
      "BaseUrl": "https://yapayzekalab.org",
      "Model": "kimi-k3"
    }
  },
  "DeveloperAgent": {
    "ManifestMaxTokens": 16384,
    "FileEditMaxTokens": 32768,
    "MaxManifestFiles": 20,
    "MechanicalReasoningEffort": "low",
    "ModifyReasoningEffort": "low"
  }
}
