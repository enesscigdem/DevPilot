{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "SingleLine": true
      }
    }
  },
  "AiProvider": {
    "Kimi": {
      "BaseUrl": "https://yapayzekalab.org",
      "Model": "kimi-k2.7-code"
    }
  },
  "DeveloperAgent": {
    "MaxOutputTokens": 32768,
    "ManifestMaxTokens": 16384,
    "FileEditMaxTokens": 32768,
    "MaxManifestFiles": 10,
    "MaxGenerationCalls": 15,
    "MaxConcurrentFileGenerations": 2
  }
}
