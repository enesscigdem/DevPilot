{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevPilotDb": "Host=localhost;Port=5432;Database=devpilot;Username=devpilot;Password=devpilot"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "MergePolicy": {
    "AllowNoChecks": false
  },
  "AiProvider": {
    "Provider": "Kimi",
    "Kimi": {
      "Model": "kimi-k3"
    }
  },
  "GitProvider": {
    "Provider": "GitHub",
    "GitHub": {
      "BaseUrl": "https://api.github.com",
      "AppId": "",
      "AppSlug": "devpilot-app",
      "ClientId": "",
      "ClientSecret": "",
      "PrivateKeyPem": "",
      "PrivateKeyPath": "",
      "EnableLegacyPatFallback": false,
      "FallbackToken": ""
    }
  },
  "RepositoryClone": {
    "WorkspaceRoot": "",
    "Timeout": "00:05:00"
  },
  "ExecutionReliability": {
    "MaxCompileRepairRounds": 3,
    "MaxTestRepairRounds": 3,
    "MaxFlakeReruns": 1,
    "AgenticRepairEnabled": true,
    "VisualCaptureEnabled": false,
    "MaxAgenticTurns": 12,
    "AgenticRepairMaxMinutes": 4,
    "AgenticRepairCallTimeoutSeconds": 90,
    "MaxAgenticCheckRuns": 4,
    "MaxGenerationCalls": 40,
    "MaxConcurrentFileGenerations": 2,
    "MaxOutputTokens": 32768,
    "ImpactAnalysisMaxOutputTokens": 6144,
    "ImpactAnalysisRecoveryMaxOutputTokens": 8192
  },
  "Hangfire": {
    "WorkerCount": 5
  },
  "AiPricing": {
    "InputPerMillionTokensUsd": null,
    "OutputPerMillionTokensUsd": null
  },
  "DeveloperAgent": {
    "ManifestMaxTokens": 16384,
    "FileEditMaxTokens": 32768,
    "MaxManifestFiles": 20,
    "MechanicalReasoningEffort": "low",
    "ModifyReasoningEffort": "low",
    "TokenBudgets": {
      "ModifyPatch": 8192
    }
  }
}
