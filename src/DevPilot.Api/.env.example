# Kimi API key (OpenAI-compatible endpoint).
# Set this as an environment variable before running the API.
# Do NOT commit a real .env file.
KIMI_API_KEY=YOUR_KIMI_API_KEY_HERE

# GitHub personal access token for the Git provider integration.
# Configure via environment variable or .NET User Secrets.
# Do NOT commit a real token.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
